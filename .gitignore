# ==========================================================
# .gitignore for Brief Application (PHP MVC + React TS + Vite)
# ==========================================================

# Dependencies
node_modules/
frontend/node_modules/
vendor/

# Build and local cache
.vite/
frontend/.vite/
frontend/dist/
.cache/
.parcel-cache/
*.tsbuildinfo

# Compiled frontend output (served by PHP from view/)
view/*

# Local PHP configuration and runtime
php.ini
*.ini
*.user.ini

# Environment and sensitive secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tests/*.log

# Local databases, dumps and runtime data
database/*.sqlite
database/*.sqlite-journal
database/*.db
*.sqlite
*.sqlite3
*.db
*.sql
*.sql.gz
brief_db.sql

# Temporary files and test profiles
tmp/
temp/
*.tmp
temp_*/
tmp_*/
puppeteer_*/
scratch/
.system_generated/
coverage/
.nyc_output/
.phpunit.cache/
.phpunit.result.cache

# IDE and Code Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini