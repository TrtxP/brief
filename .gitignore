# ==========================================================
# .gitignore for Brief Application (PHP MVC + React TS + Vite)
# ==========================================================

# Dependencies
node_modules/
frontend/node_modules/
vendor/

# Build and local cache
.vite/
frontend/.vite/
frontend/dist/
.cache/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tests/*.log

# Local databases and runtime data
database/*.sqlite
database/*.sqlite-journal
database/*.db
*.sqlite
*.sqlite3

# Environment and sensitive secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and Code Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
.project
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp
